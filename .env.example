# Copy to .env and fill in. Never commit .env.

# Finds new uploads and ended streams, and reads public view counts
YOUTUBE_API_KEY=

# AI providers (tried in the order set in config.yaml)
GEMINI_API_KEY=
FREE_LLM_BASE_URL=          # e.g. https://your-provider.example/v1
FREE_LLM_API_KEY=
FREE_LLM_MODEL=

# Discord: alerts, clip review buttons and commands
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=         # the channel the bot posts in and listens to
DISCORD_OWNER_ID=           # your Discord user ID; only you can control the bot

# Campaign finder (reads Whop's public campaign listings through Apify)
APIFY_TOKEN=

# Optional: also review on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Instagram (Professional account) and Facebook Page
IG_MAIN_USER_ID=
IG_MAIN_TOKEN=
FB_MAIN_PAGE_ID=
FB_MAIN_PAGE_TOKEN=
